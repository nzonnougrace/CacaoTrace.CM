<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CacaoTrace.CM.Controls.AppHeader"
             x:Name="root">
    <Grid BackgroundColor="{StaticResource Primary}" Padding="20,20" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

        <Label Text="←" FontSize="28" TextColor="White" VerticalOptions="Center"
               IsVisible="{Binding ShowBack, Source={x:Reference root}}">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackTapped" />
            </Label.GestureRecognizers>
        </Label>

        <Label Grid.Column="1" Text="{Binding Title, Source={x:Reference root}}"
               FontSize="24" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />

        <Border Grid.Column="2" WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 24"
                StrokeThickness="0" BackgroundColor="{StaticResource Accent}"
                IsVisible="{Binding ShowAvatar, Source={x:Reference root}}">
            <Label Text="AF" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}"
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAvatarTapped" />
            </Border.GestureRecognizers>
        </Border>

        <Label Grid.Column="2" Text="⋮" FontSize="30" TextColor="White" VerticalOptions="Center"
               IsVisible="{Binding ShowMenu, Source={x:Reference root}}">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMenuTapped" />
            </Label.GestureRecognizers>
        </Label>
    </Grid>
</ContentView>
