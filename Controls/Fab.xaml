<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CacaoTrace.CM.Controls.Fab"
             HorizontalOptions="End" VerticalOptions="End" Margin="0,0,24,24">
    <Border WidthRequest="64" HeightRequest="64" StrokeShape="RoundRectangle 32" StrokeThickness="0"
            BackgroundColor="{StaticResource Accent}">
        <Border.Shadow>
            <Shadow Brush="#F9A825" Opacity="0.45" Radius="18" Offset="0,6" />
        </Border.Shadow>
        <Label Text="+" FontSize="36" TextColor="{StaticResource PrimaryDark}"
               HorizontalOptions="Center" VerticalOptions="Center" />
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
    </Border>
</ContentView>
