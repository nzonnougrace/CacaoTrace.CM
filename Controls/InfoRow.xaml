<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CacaoTrace.CM.Controls.InfoRow"
             x:Name="root">
    <Border Style="{StaticResource Card}" Padding="20,18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Label Text="{Binding Caption, Source={x:Reference root}}" FontSize="17" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="{Binding Value, Source={x:Reference root}}" FontSize="17"
                   FontAttributes="Bold" TextColor="{StaticResource Primary}"
                   HorizontalOptions="End" HorizontalTextAlignment="End" VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
