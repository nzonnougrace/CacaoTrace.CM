<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:CacaoTrace.CM.Controls"
             x:Class="CacaoTrace.CM.Controls.ListCard">
    <Border Style="{StaticResource Card}" Padding="20,18">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
            <Label x:Name="TitleLbl" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />
            <ctrl:Badge x:Name="Bdg" Grid.Column="1" IsVisible="False" HorizontalOptions="End" />
            <Label x:Name="SubLbl" Grid.Row="1" Grid.ColumnSpan="2" FontSize="16" TextColor="#757575" />
        </Grid>
    </Border>
</ContentView>
