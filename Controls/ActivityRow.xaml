<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CacaoTrace.CM.Controls.ActivityRow"
             x:Name="root">
    <Grid BackgroundColor="White" RowDefinitions="Auto,1">
        <VerticalStackLayout Padding="20,15" Spacing="4">
            <Label Text="{Binding Title, Source={x:Reference root}}" FontSize="18" FontAttributes="Bold" />
            <Label Text="{Binding Subtitle, Source={x:Reference root}}" FontSize="15" TextColor="{StaticResource TextGrey}" />
        </VerticalStackLayout>
        <BoxView Grid.Row="1" HeightRequest="1" Color="#E0E0E0" />
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Grid.GestureRecognizers>
    </Grid>
</ContentView>
