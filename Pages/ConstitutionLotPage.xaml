<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:ctrl="clr-namespace:CacaoTrace.CM.Controls" x:Class="CacaoTrace.CM.Pages.ConstitutionLotPage" Title="Constitution d'un lot">
    <Grid RowDefinitions="Auto,*">
        <ctrl:AppHeader Title="Constitution d'un lot" ShowBack="True" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="26,24,26,32" Spacing="14" MaximumWidthRequest="560">
                <Label Text="Sélection des récoltes" Style="{StaticResource SectionTitle}" />

                <Border Style="{StaticResource Card}" Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <CheckBox IsChecked="True" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Ekona" FontAttributes="Bold" FontSize="18" />
                            <Label Text="14 sept. 2026 · Qualité A" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="120 kg" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <CheckBox IsChecked="True" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Ekona" FontAttributes="Bold" FontSize="18" />
                            <Label Text="28 août 2026 · Qualité A" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="95 kg" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <CheckBox />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Muyuka" FontAttributes="Bold" FontSize="18" />
                            <Label Text="09 sept. 2026 · Qualité B" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="85 kg" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <CheckBox />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Tiko Nord" FontAttributes="Bold" FontSize="18" />
                            <Label Text="20 août 2026 · Qualité A" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="160 kg" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <ctrl:PickerField Caption="Traitement" ItemsSource="{StaticResource Traitements}" SelectedItem="Séché" Margin="0,8,0,0" />
                <Button Text="Créer le lot" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Clicked="OnBack" />
                <Button Text="Annuler" Style="{StaticResource OutlineButton}" Clicked="OnBack" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
