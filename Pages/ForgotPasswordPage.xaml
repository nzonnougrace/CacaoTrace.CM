<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:ctrl="clr-namespace:CacaoTrace.CM.Controls" x:Class="CacaoTrace.CM.Pages.ForgotPasswordPage" Title="Mot de passe oublié">
    <Grid RowDefinitions="Auto,*">
        <ctrl:AppHeader Title="Mot de passe oublié" ShowBack="True" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="26,32" Spacing="20" MaximumWidthRequest="520">
                <Label Text="Récupération du mot de passe" Style="{StaticResource H1}" FontSize="26" />
                <Label Text="Saisissez votre email ou votre téléphone : nous vous enverrons un lien pour choisir un nouveau mot de passe."
                       Style="{StaticResource Muted}" FontSize="17" />
                <ctrl:FormField Caption="Email ou téléphone" Text="amina.fofana@mail.cm" />
                <Button Text="Envoyer le lien" Style="{StaticResource PrimaryButton}" Clicked="OnSend" />
                <Button Text="Annuler" Style="{StaticResource OutlineButton}" Clicked="OnBack" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
