<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:ctrl="clr-namespace:CacaoTrace.CM.Controls" x:Class="CacaoTrace.CM.Pages.ChangePasswordPage" Title="Changer le mot de passe">
    <Grid RowDefinitions="Auto,*">
        <ctrl:AppHeader Title="Changer le mot de passe" ShowBack="True" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="26,24,26,32" Spacing="18" MaximumWidthRequest="560">
                <ctrl:FormField Caption="Mot de passe actuel" IsPassword="True" ShowToggle="True" />
                <ctrl:FormField Caption="Nouveau mot de passe" IsPassword="True" ShowToggle="True" />
                <ctrl:FormField Caption="Confirmer le nouveau mot de passe" IsPassword="True" ShowToggle="True" />
                <Button Text="Mettre à jour" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Clicked="OnBack" />
                <Button Text="Annuler" Style="{StaticResource OutlineButton}" Clicked="OnBack" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
