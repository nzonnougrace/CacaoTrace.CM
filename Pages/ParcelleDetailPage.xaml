<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:ctrl="clr-namespace:CacaoTrace.CM.Controls"
             x:Class="CacaoTrace.CM.Pages.ParcelleDetailPage"
             Title="Fiche parcelle">
    <Grid RowDefinitions="Auto,*">
        <ctrl:AppHeader x:Name="Header" Title="Fiche parcelle" ShowBack="True" ShowMenu="True" MenuClicked="OnMenu" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0">

                <Grid HeightRequest="130">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#2E7D32" Offset="0" />
                            <GradientStop Color="#1B5E20" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Label Text="🌳" FontSize="72" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout Padding="26,24,26,32" Spacing="16" MaximumWidthRequest="560">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Parcelle Ekona" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        <Label Text="Ekona, Sud-Ouest · créée le 12 mars 2024" FontSize="17" TextColor="{StaticResource TextGrey}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                        <ctrl:StatTile Caption="Superficie" Value="2,4 ha" />
                        <ctrl:StatTile Grid.Column="1" Caption="Variété" Value="Forastero" />
                        <ctrl:StatTile Grid.Row="1" Caption="Nombre de pieds" Value="1 280" />
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="18,14">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Statut" FontSize="15" TextColor="{StaticResource TextGrey}" />
                                <ctrl:Badge Text="ACTIVE" Kind="green" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,6,0,0">
                        <Button Text="Modifier" Style="{StaticResource OutlineButton}" HeightRequest="52" FontSize="17"
                                Clicked="OnEdit" />
                        <Button Grid.Column="1" Text="+ Récolte" Style="{StaticResource PrimaryButton}" HeightRequest="52"
                                FontSize="17" Clicked="OnAddHarvest" />
                    </Grid>
                    <Button Text="Voir l'historique" Style="{StaticResource OutlineButton}" HeightRequest="52" FontSize="17"
                            Clicked="OnHistory" />

                    <Label Text="Récoltes associées" Style="{StaticResource SectionTitle}" Margin="0,10,0,0" />
                    <VerticalStackLayout Spacing="12">
                        <ctrl:InfoRow Caption="14 sept. 2026 · Qualité A" Value="120 kg" />
                        <ctrl:InfoRow Caption="28 août 2026 · Qualité B"  Value="95 kg" />
                        <ctrl:InfoRow Caption="10 août 2026 · Qualité A"  Value="140 kg" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
