<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:ctrl="clr-namespace:CacaoTrace.CM.Controls"
             x:Class="CacaoTrace.CM.Pages.LoginPage"
             Title="Connexion">
    <ScrollView>
        <VerticalStackLayout Padding="28,64,28,28" Spacing="0" MaximumWidthRequest="520">

            <Border HorizontalOptions="Center" BackgroundColor="{StaticResource Primary}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 24" Padding="22,14">
                <Label Text="CACAOTRACE CM" TextColor="White" FontSize="21" FontAttributes="Bold" CharacterSpacing="2" />
            </Border>

            <Label Text="Bienvenue sur CacaoTrace CM" Style="{StaticResource H1}"
                   HorizontalTextAlignment="Center" Margin="0,30,0,8" />
            <Label Text="Connectez-vous pour continuer" FontSize="19" TextColor="{StaticResource TextGrey}"
                   HorizontalTextAlignment="Center" Margin="0,0,0,36" />

            <ctrl:FormField Caption="Email ou téléphone" Text="amina.fofana@mail.cm" Margin="0,0,0,18" />
            <ctrl:FormField Caption="Mot de passe" Text="12345678" IsPassword="True" ShowToggle="True" />

            <Label Text="Mot de passe oublié ?" TextColor="{StaticResource Green}" FontSize="18"
                   FontAttributes="Bold" HorizontalOptions="End" Margin="0,20,0,20">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnForgot" />
                </Label.GestureRecognizers>
            </Label>

            <Button Text="Se connecter" Style="{StaticResource PrimaryButton}" HeightRequest="62" Clicked="OnLogin" />

            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="14" Margin="0,24">
                <BoxView HeightRequest="1" Color="#E0E0E0" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="ou" TextColor="{StaticResource TextGrey}" FontSize="17" />
                <BoxView Grid.Column="2" HeightRequest="1" Color="#E0E0E0" VerticalOptions="Center" />
            </Grid>

            <Button Text="Créer un compte" Style="{StaticResource OutlineButton}" Clicked="OnRegister" />

            <Label Text="En continuant, vous acceptez les Conditions d'utilisation et la Politique de confidentialité."
                   FontSize="14" TextColor="{StaticResource TextGrey}" HorizontalTextAlignment="Center"
                   Margin="16,26,16,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
