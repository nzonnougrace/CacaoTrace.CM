<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:ctrl="clr-namespace:CacaoTrace.CM.Controls"
             x:Class="CacaoTrace.CM.Pages.ProfilPage"
             Title="Mon profil">
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout BackgroundColor="{StaticResource Primary}" Spacing="0">
            <ctrl:AppHeader Title="Mon profil" ShowBack="True" />
            <VerticalStackLayout Padding="0,14,0,26" Spacing="10">
                <Border WidthRequest="90" HeightRequest="90" StrokeShape="RoundRectangle 28" StrokeThickness="0"
                        BackgroundColor="{StaticResource Accent}" HorizontalOptions="Center">
                    <Label Text="AF" FontSize="42" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Amina Fofana" FontSize="28" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                <Label Text="Agricultrice · Sud-Ouest" FontSize="17" TextColor="#EFEBE9" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="22,18,22,32" Spacing="12" MaximumWidthRequest="560">

                <Label Text="Compte" Style="{StaticResource SectionTitle}" />
                <ctrl:InfoRow Caption="Email"     Value="amina.fofana@mail.cm" />
                <ctrl:InfoRow Caption="Téléphone" Value="+237 699 00 11 22" />
                <ctrl:InfoRow Caption="Région"    Value="Sud-Ouest" />

                <Label Text="Préférences" Style="{StaticResource SectionTitle}" Margin="0,12,0,0" />
                <ctrl:InfoRow Caption="Langue"       Value="Français" />
                <ctrl:InfoRow Caption="Thème sombre" Value="Désactivé" />
                <ctrl:InfoRow Caption="Notifications" Value="Activées" />

                <Button Text="Modifier le profil" Style="{StaticResource OutlineButton}" Margin="0,18,0,0" Clicked="OnEdit" />
                <Button Text="Se déconnecter" Style="{StaticResource DangerButton}" Clicked="OnLogout" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
